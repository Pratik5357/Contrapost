        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ledger_rate_limited_total[$__rate_interval])) or vector(0)",
          "legendFormat": "rate limited (429)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ledger_rate_limiter_failed_open_total[$__rate_interval])) or vector(0)",
          "legendFormat": "limiter failed open"
        }
      ]
